# Kopirajte v .env in prilagodite:  cp .env.example .env

# OBVEZNO: skrivni ključ za seje. Ustvarite ga z:  openssl rand -hex 32
JWT_SECRET=

# Geslo baze (privzeto "postgres"). Pozor: pri že obstoječi bazi se geslo NE spremeni
# s spremembo te vrednosti. Spremenite ga v bazi (ALTER USER) in šele nato tukaj.
# Uporabite le črke in številke (npr. openssl rand -hex 16).
POSTGRES_PASSWORD=postgres

# Neobvezno: samodejno branje naslovnic iz COBISS prek Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- E-pošta (neobvezno): uporabniki si sami ponastavijo geslo, povabila po e-pošti ---
# Vklopljeno je, ko so nastavljeni SMTP_HOST, SMTP_FROM (ali SMTP_USER z @) in APP_URL.
# APP_URL: javni naslov aplikacije brez končnega /, uporabljen v povezavah v e-pošti.
APP_URL=
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS (587) ali brez šifriranja, true = implicitni TLS (465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Knjigomatik <knjige@primer.si>
# false samo, če ima vaš strežnik samopodpisan certifikat
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Gostitelj-port, na katerem je aplikacija dosegljiva
APP_PORT=3000

# Piškotki "secure": auto (privzeto, glede na https), true ali false
COOKIE_SECURE=auto

# Časovni pas za samodejne datume branja
APP_TZ=Europe/Ljubljana

# Verzija slike (npr. 2.0.0) ali latest
KNJIGOMATIK_VERSION=latest
