import { NextRequest, NextResponse } from "next/server";
import * as cheerio from "cheerio";

export async function GET(request: NextRequest) {
  const queryRaw = request.nextUrl.searchParams.get("isbn");
  if (!queryRaw) return NextResponse.json({ error: "Manjka podatek" }, { status: 400 });

  const cobissId = queryRaw.replace(/[^0-9]/g, "").trim();
  if (!cobissId) {
    return NextResponse.json({ error: "Neveljaven COBISS ID" }, { status: 400 });
  }

  try {
    const detailUrl = `https://plus.cobiss.net/cobiss/si/sl/data/cobib/${cobissId}?format=detail`;
    
    // Uporabimo točno tvoj User-Agent in nastavitve iz whoami izpisa
    const detailRes = await fetch(detailUrl, {
      cache: "no-store",
      headers: {
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8",
        "Accept-Language": "sl-SI,sl;q=0.9,en-GB;q=0.8,en;q=0.7",
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36",
        "Referer": `https://plus.cobiss.net/cobiss/si/sl/bib/${cobissId}`
      }
    });

    if (!detailRes.ok) {
      return NextResponse.json({ error: `COBISS je vrnil napako: ${detailRes.status}` }, { status: 404 });
    }

    const detailHtml = await detailRes.text();
    const $ = cheerio.load(detailHtml);

    let title = "";
    let author = "";
    let year: number | null = null;

    $("tr").each((_, row) => {
      const tds = $(row).find("td");
      if (tds.length >= 2) {
        const label = $(tds).eq(0).text().trim();
        const value = $(tds).eq(1).text().trim();

        if (label === "Avtor") {
          author = value;
        } else if (label === "Naslov") {
          title = value.split("/")[0].split("[")[0].trim();
        } else if (label === "Leto") {
          const yearMatch = value.match(/\b(19|20)\d{2}\b/);
          if (yearMatch) year = parseInt(yearMatch[0], 10);
        }
      }
    });

    return NextResponse.json({
      title: title || "Neznan naslov",
      author: author || "Neznan avtor",
      year: year,
      thumbnail: `https://d.cobiss.net/repository/si/thumbnails/cobib/${cobissId}`,
      description: `https://plus.cobiss.net/cobiss/si/sl/bib/${cobissId}`
    });

  } catch (error: any) {
    console.error("COBISS error:", error);
    return NextResponse.json({ error: `Napaka pri uvozu: ${error.message}` }, { status: 500 });
  }
}